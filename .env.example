# Mtz.City env template.  Copy to .env.local for development; set these
# on Railway for production.

# Postgres (Railway auto-injects DATABASE_URL when the DB plugin is linked)
DATABASE_URL=

# Site identity / location
SITE_NAME=mtz.city
LOCATION_NAME=Martinez, CA
LOCATION_SHORT=Martinez
LAT=38.01
LON=-122.14
TIMEZONE=America/Los_Angeles

# Per-location overrides (all optional)
NOAA_BUOYS=
PURPLEAIR_SENSOR=
FOURSQUARE_CATEGORIES=10000,13000,14003,16000
FOURSQUARE_RADIUS_M=5000
TICKETMASTER_GENRES=
NEWS_RSS_URLS=

# API keys / tokens
NOAA_TOKEN=
WEATHERAPI_KEY=
PURPLEAIR_KEY=
WEATHERSTACK_KEY=
OPENWEATHER_KEY=
TWELVEDATA_KEY=
FOURSQUARE_KEY=
TICKETMASTER_KEY=
EBIRD_TOKEN=
